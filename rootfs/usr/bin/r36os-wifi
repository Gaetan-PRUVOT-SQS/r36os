#!/bin/sh
export PATH=/usr/local/sbin:/usr/sbin:/sbin:/usr/bin:/bin

iface=""
for i in /sys/class/net/wlan* /sys/class/net/wlx*; do
  if [ -e "$i" ]; then
    iface=${i##*/}
    break
  fi
done
if [ -z "$iface" ]; then
  echo "r36os: pas de wifi"
  echo "La puce 8188fu n'est pas vue."
  sleep 8
  exit 1
fi
if [ ! -x /sbin/wpa_supplicant ]; then
  echo "r36os: wpa_supplicant absent"
  sleep 8
  exit 1
fi

if [ -x /usr/bin/r36os-clavier ]; then
  /usr/bin/r36os-clavier &
fi

echo "Wifi sur $iface"
printf "Nom du reseau : "
read -r ssid
printf "Mot de passe, vide si le reseau est ouvert : "
# Le mot de passe ne s'affiche pas pendant la saisie.
trap 'stty echo 2>/dev/null' EXIT
stty -echo 2>/dev/null || true
read -r cle
stty echo 2>/dev/null || true
echo
case $ssid in
  ""|*\"*|*\\*)
    echo "r36os: nom refuse"
    sleep 4
    exit 1
    ;;
esac
case $cle in
  *\"*|*\\*)
    echo "r36os: mot de passe refuse"
    sleep 4
    exit 1
    ;;
esac
# WPA demande entre 8 et 63 caracteres.
if [ -n "$cle" ] && { [ "${#cle}" -lt 8 ] || [ "${#cle}" -gt 63 ]; }; then
  echo "r36os: le mot de passe doit faire de 8 a 63 caracteres"
  sleep 4
  exit 1
fi

umask 077
mkdir -p /run/r36os /run/wpa_supplicant
conf=/run/r36os/wpa.conf
if [ -z "$cle" ]; then
  cat > "$conf" << EOF
ctrl_interface=/run/wpa_supplicant
update_config=0
network={
  ssid="$ssid"
  key_mgmt=NONE
  scan_ssid=1
}
EOF
else
  cat > "$conf" << EOF
ctrl_interface=/run/wpa_supplicant
update_config=0
network={
  ssid="$ssid"
  psk="$cle"
  scan_ssid=1
}
EOF
fi
chmod 600 "$conf"

if [ -f /run/r36os/wpa.pid ]; then
  kill "$(cat /run/r36os/wpa.pid)" 2>/dev/null || true
  sleep 1
fi
if ! wpa_supplicant -B -P /run/r36os/wpa.pid -i "$iface" -c "$conf"; then
  echo "r36os: echec wifi"
  sleep 8
  exit 1
fi
sleep 2
busybox udhcpc -i "$iface" -s /usr/lib/r36os/udhcpc.sh -n -q -t 8 -T 2 || true
echo
ip -4 addr show "$iface" || true
echo "r36os: fini"
sleep 6

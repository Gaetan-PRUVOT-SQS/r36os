#!/bin/sh

export PATH=/bin

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

insmod /modules/virtio.ko || exec sh
insmod /modules/virtio_ring.ko || exec sh
insmod /modules/virtio_mmio.ko || exec sh
insmod /modules/virtio_blk.ko || exec sh
insmod /modules/virtio_input.ko || exec sh

i=0
while [ ! -b /dev/vda ]; do
  i=$((i + 1))
  if [ "$i" -gt 15 ]; then
    echo "r36os: disque absent"
    exec sh
  fi
  sleep 1
done

mkdir -p /newroot
if ! mount -t ext4 /dev/vda /newroot; then
  echo "r36os: disque illisible"
  exec sh
fi

mount --move /proc /newroot/proc
mount --move /sys /newroot/sys
mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init

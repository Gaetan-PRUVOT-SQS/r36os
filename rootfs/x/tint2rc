# Barre du bas : menu, clavier, fenetres, lumiere, son, batterie, heure.
panel_items = PPTEEEC
panel_size = 100% 36
panel_margin = 0 0
panel_padding = 2 2 4
panel_background_id = 1
panel_position = bottom center horizontal
panel_layer = top
panel_monitor = all
autohide = 0
strut_policy = follow_size
disable_transparency = 1
font_shadow = 0

# Fond 1 : gris fonce, sans bord
rounded = 0
border_width = 0
background_color = #202020 100
border_color = #202020 0

taskbar_mode = single_desktop
taskbar_padding = 2 0 2
taskbar_background_id = 0
taskbar_active_background_id = 0
task_text = 1
task_icon = 0
task_centered = 1
task_maximum_size = 140 32
task_padding = 4 2 4
task_font = DejaVu Sans 10
task_font_color = #ffffff 100
task_active_font_color = #ffffff 100
task_background_id = 0
task_active_background_id = 0
mouse_left = toggle_iconify
mouse_middle = close

button = new
button_text = Menu
button_font = DejaVu Sans Bold 10
button_font_color = #ffffff 100
